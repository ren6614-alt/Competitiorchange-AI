# ==============================================================================
# CompetitorChange AI - Environment Variables Reference (.env.example)
#
# RULE: Store real secrets in private .env file only. Never commit credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Free Development Mode & Cost Protection Safeguards
# ------------------------------------------------------------------------------
FREE_DEVELOPMENT_MODE=true
MAX_AI_REQUESTS_PER_USER_DAY=25
MAX_SCANS_PER_USER_DAY=10
MAX_PAGES_PER_SCAN=3

# ------------------------------------------------------------------------------
# Public Client-Side Variables (Exposed via Vite - Non-Sensitive Only)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Server-Side Secrets (STRICTLY PRIVATE - Never exposed to browser or client bundle)
# ------------------------------------------------------------------------------
# Google AI Studio / Gemini Free Tier API Key (https://aistudio.google.com)
GEMINI_API_KEY=

# Supabase Service Role Key (Backend administrative queries only)
SUPABASE_SERVICE_ROLE_KEY=

# Web Crawler Provider ('demo' for free built-in mock, or 'firecrawl')
CRAWLER_PROVIDER=demo
CRAWLER_API_KEY=

# Customer Manual UPI Payments (For receiving software subscription fees via Google Pay/UPI)
# Note: This is strictly for software sales to customers, NOT connected to Google Cloud billing.
GPAY_UPI_ID=
GPAY_PAYEE_NAME=

# Transactional Email Alerts (Optional - Simulated in development if omitted)
RESEND_API_KEY=

# Application Base URL
APP_URL=https://competitorchangeai.netlify.app/

